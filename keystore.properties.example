# Copy to keystore.properties (gitignored) and fill in real values.
# Generate a keystore with: keytool -genkeypair -v -keystore release.jks \
#   -alias <keyAlias> -keyalg RSA -keysize 2048 -validity 10000
storeFile=/absolute/path/to/release.jks
storePassword=
keyAlias=
keyPassword=

# .github/workflows/release.yml (triggered by pushing a `v*` tag) builds
# this same signing config from repo secrets instead of this file:
#   RELEASE_KEYSTORE_BASE64   — `base64 -w0 release.jks`
#   RELEASE_KEYSTORE_PASSWORD — same as storePassword above
#   RELEASE_KEY_ALIAS         — same as keyAlias above
#   RELEASE_KEY_PASSWORD      — same as keyPassword above
# Optional Play Store upload (same workflow, separate job): set the repo
# variable PLAY_PUBLISHING_ENABLED=true and add a PLAY_SERVICE_ACCOUNT_JSON
# secret (a Play Console service account key with Release Manager access)
# once ready — until then that job is skipped, not failed.
